+        syncDecisionDraft() {
+            const decision = this.pendingDecision();
+            if (!decision) {
+                this.decisionDraft = {
+                    ordered_participant_ids: [],
+                    selected_participant_ids: [],
+                    group_assignments: {},
+                };
+                return;
+            }
+
+            const eligible = [...(decision.eligible_participant_ids ?? [])];
+            this.decisionDraft = {
+                ordered_participant_ids: eligible,
+                selected_participant_ids: [],
+                group_assignments: Object.fromEntries(
+                    eligible.map(id => [id, ''])
+                ),
+            };

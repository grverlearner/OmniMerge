+    /**
+     * Orden canónico de slots para un bracket sembrado.
+     *
+     * 8 => [1, 8, 4, 5, 2, 7, 3, 6]
+     */
+    private function canonicalSeedOrder(
+        int $size
+    ): array {
+        if (
+            $size < 2
+            ||
+            ! $this->isPowerOfTwo($size)
+        ) {
+            $this->fail(
+                'El bracket sembrado necesita una capacidad potencia de 2.'
+            );
+        }
+
+        $order = [
+            1,
+            2,
+        ];
+
+        for (
+            $current = 4;
+            $current <= $size;
+            $current *= 2
+        ) {
+            $next = [];
+
+            foreach (
+                $order
+                as
+                $seed
+            ) {
+                $next[] =
+                    $seed;
+
+                $next[] =
+                    $current + 1 - $seed;
+            }
+
+            $order =
+                $next;
+        }
+
+        return $order;
+    }
+
+    private function randomOrder(
+        array $participantIds,
+        string $context
+    ): array {
+        usort(
+            $participantIds,
+            fn($left, $right) =>
+                strcmp(
+                    hash(
+                        'sha256',
+                        $context . ':' . $left
+                    ),
+                    hash(
+                        'sha256',
+                        $context . ':' . $right
+                    )
+                )
+        );
+
+        return $participantIds;
+    }
